{
    "name": "MLOps Python Environment",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.formatting.provider": "black"
            },
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "forwardPorts": [
        5000,
        5001,
        5002
    ],
    "portsAttributes": {
        "5000": {
            "label": "MLflow",
            "onAutoForward": "notify"
        },
        "5001": {
            "label": "MLflow Compose Registry",
            "onAutoForward": "notify"
        },
        "5002": {
            "label": "MLflow Models local serving",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "python -m pip install -r requirements-train.txt -r requirements-serving.txt -r models/serving/model/requirements.txt"
}
