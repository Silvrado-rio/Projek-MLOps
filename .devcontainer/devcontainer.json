{
    "name": "MLOps Python Environment",
    "image": "mcr.microsoft.com/devcontainers/python:3.10",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.formatting.provider": "black"
            },
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "forwardPorts": [5000],
    "portsAttributes": {
        "5000": {"label": "MLflow", "onAutoForward": "notify"}
    },
    "postCreateCommand": "python -m pip install -r requirements-train.txt"
}
